<a class="post fx" href="{{ post.url }}" data-cat="{{ post.data.category }}"><div class="cover" data-cover="{{ loop.index0 }}" data-cat="{{ post.data.category }}">{% if post.data.cover %}<img src="{{ post.data.cover }}" alt="{{ post.data.cover_alt or '' }}" loading="lazy">{% endif %}</div><span class="cat">{{ post.data.category }}</span><h3>{{ post.data.title }}</h3><span class="meta">{{ post.date | readableDate }}</span></a>